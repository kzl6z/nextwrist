PORT=3000
DB_PATH=casino.sqlite

# ---------------------------------------------------------------
# Football du monde entier, gratuit : clé API-Football (https://dashboard.api-football.com/register)
# L'offre gratuite donne 100 requêtes par jour : calendrier mondial, nos propres cotes calculées
# sur les résultats, et le direct de tous les matchs en cours (score et minute, environ toutes
# les 10 minutes). Laisser vide pour ne pas l'utiliser.
# ---------------------------------------------------------------
APIFOOTBALL_KEY=
# Requêtes par jour de ton offre (100 en gratuit).
APIFOOTBALL_DAILY=100
# Une équipe n'est cotée qu'après ce nombre de matchs de championnat appris.
APIFOOTBALL_MIN_GAMES=4
# Jours de résultats passés chargés au premier lancement pour amorcer notre classement.
APIFOOTBALL_BOOTSTRAP_DAYS=28

# ---------------------------------------------------------------
# Vrais matchs : clé The Odds API (https://the-odds-api.com)
# Sans clé, seuls les matchs virtuels sont proposés (ils se jouent tout seuls, en direct).
# ---------------------------------------------------------------
ODDS_API_KEY=

# Crédits de ton abonnement par mois : 500 (gratuit), 20000, 100000, 5000000…
# Le serveur règle tout seul le rythme des mises à jour pour ne jamais dépasser ce budget.
ODDS_MONTHLY_CREDITS=500

# Compétitions : "all" = toutes celles que le fournisseur couvre en ce moment (tous les sports),
# ou une liste de clés (https://the-odds-api.com/sports-odds-data/sports-apis.html).
# Avec le plan gratuit, garde 2 ou 3 compétitions ; avec un plan payant, mets "all".
ODDS_SPORTS=soccer_france_ligue_one,soccer_epl,soccer_uefa_champs_league

# Marchés chargés pour tous les matchs de la liste : h2h (1N2, toujours), totals (plus/moins),
# spreads (handicap). Chaque marché en plus coûte 1 crédit par compétition et par mise à jour.
ODDS_MARKETS=h2h

# Marchés supplémentaires (les deux équipes marquent, remboursé si nul, lignes alternatives
# de plus/moins et de handicap, totaux par équipe), chargés quand quelqu'un ouvre la fiche
# d'un match. "off" pour désactiver. Rafraîchis au plus toutes les N minutes par match.
ODDS_EXTRA_MARKETS=on
ODDS_EXTRA_MINUTES=15

# Direct sur les vrais matchs, deux façons au choix :
#
# 1) Moteur de cotes maison (recommandé) : pendant le match, seul le score est demandé au fournisseur
#    (1 crédit par compétition en cours), et nos modèles recalculent toutes les cotes à chaque
#    changement de score et au fil du temps : 1N2, double chance, plus/moins, handicaps, totaux
#    par équipe, les deux équipes marquent, score exact… Cash out compris.
#    Sports : football, basket, hockey, handball, rugby, football américain, baseball.
#    Le moteur complète aussi chaque fiche match avant le coup d'envoi avec tous ces marchés.
ODDS_LIVE_ENGINE=on
ODDS_LIVE_ENGINE_SECONDS=60
#
# 2) Cotes en direct des bookmakers (plus cher : chaque rafraîchissement coûte un crédit par marché).
#    Si ODDS_LIVE=on, le moteur maison n'est pas utilisé.
ODDS_LIVE=off
ODDS_LIVE_SECONDS=60

# Délai minimum entre deux mises à jour d'une même compétition à venir, et recherche des résultats (minutes)
ODDS_SYNC_MINUTES=30
SCORES_SYNC_MINUTES=60

# Bookmakers utilisés pour la moyenne des cotes : eu, uk, us, au (chaque région coûte des crédits en plus)
ODDS_REGIONS=eu

# ---------------------------------------------------------------
# Matchs virtuels : 16 sports simulés en direct (cotes recalculées toutes les 3 s, cash out).
# Toujours actifs sans clé ; avec une clé, mettre "off" pour ne garder que les vrais matchs.
# ---------------------------------------------------------------
VIRTUAL_SPORTS=on
# Durée réelle d'un match virtuel (minutes)
DEMO_MATCH_MINUTES=10
