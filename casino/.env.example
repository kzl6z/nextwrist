PORT=3000
DB_PATH=casino.sqlite
# Clé The Odds API (https://the-odds-api.com) pour les vrais matchs.
# Sans clé, le serveur génère des matchs de démo qui se jouent tout seuls.
ODDS_API_KEY=
ODDS_SPORTS=soccer_france_ligue_one,soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_uefa_champs_league,basketball_nba
# Durée d'un match de démo (minutes)
DEMO_MATCH_MINUTES=10
