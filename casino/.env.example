PORT=3000
DB_PATH=casino.sqlite

# Clé The Odds API (gratuite sur https://the-odds-api.com) pour les vrais matchs.
# Sans clé, seuls les matchs virtuels sont proposés (ils se jouent tout seuls, en direct).
ODDS_API_KEY=
# Compétitions suivies (liste : https://the-odds-api.com/sports-odds-data/sports-apis.html)
# Exemples d'autres sports : basketball_nba, icehockey_nhl, rugbyunion_six_nations, mma_mixed_martial_arts
ODDS_SPORTS=soccer_france_ligue_one,soccer_epl,soccer_uefa_champs_league
# Marchés du flux réel : h2h (1N2, toujours), totals (plus/moins), spreads (handicap).
# Chaque marché en plus coûte 1 crédit de plus par compétition et par mise à jour.
ODDS_MARKETS=h2h
# Mise à jour des cotes et des résultats (minutes). Voir le calcul de quota dans le README.
ODDS_SYNC_MINUTES=360
SCORES_SYNC_MINUTES=120

# Matchs virtuels (direct, cash out en cours de match). Toujours actifs sans clé ;
# avec une clé, mettre "off" pour ne garder que les vrais matchs.
VIRTUAL_SPORTS=on
# Durée réelle d'un match virtuel (minutes)
DEMO_MATCH_MINUTES=10
