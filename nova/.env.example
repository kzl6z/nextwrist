# Copier en .env puis ajuster. Ne JAMAIS commiter .env.

# Base de donnees (utilisateur:motdepasse@hote:port/base)
NOVA_DATABASE_URL=postgresql://nova:change-me@localhost:5432/nova
POSTGRES_PASSWORD=change-me

# Ollama : API compatible OpenAI.
#   Nova hors Docker      -> http://localhost:11434/v1
#   Nova dans Docker (Mac/Win) -> http://host.docker.internal:11434/v1
#   Nova dans Docker (Linux)   -> http://172.17.0.1:11434/v1
NOVA_OLLAMA_URL=http://localhost:11434/v1

# Modeles (voir docs/nova/02-technologies-choix.md pour choisir selon ta machine)
NOVA_CHAT_MODEL=qwen3:8b
NOVA_EMBEDDING_MODEL=bge-m3

# Reglages
NOVA_TEMPERATURE=0.4
NOVA_LOG_LEVEL=INFO
