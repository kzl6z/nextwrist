# Copier en .env puis ajuster. Ne JAMAIS commiter .env.

# Base de donnees (utilisateur:motdepasse@hote:port/base)
NOVA_DATABASE_URL=postgresql://nova:change-me@localhost:5432/nova
POSTGRES_PASSWORD=change-me

# Ollama : API compatible OpenAI.
#   Nova hors Docker      -> http://localhost:11434/v1
#   Nova dans Docker (Mac/Win) -> http://host.docker.internal:11434/v1
#   Nova dans Docker (Linux)   -> http://172.17.0.1:11434/v1
NOVA_OLLAMA_URL=http://localhost:11434/v1

# Modeles (voir docs/nova/02-technologies-choix.md pour choisir selon ta machine)
#
# ⚠️ LE MODELE DOIT TENIR DANS ENVIRON 45 % DE TA MEMOIRE VIVE.
#
# Au-dela il ne refuse pas de tourner : il pagine sur le disque, sans erreur
# ni message, et une question simple met plusieurs minutes. Nova le signale
# desormais au demarrage, mais autant ne pas s'y mettre.
#
#   8 Go  -> llama3.2:3b (2,0 Go) · qwen3:4b (2,6 Go) · qwen2.5:3b (1,9 Go)
#   16 Go -> qwen3:8b (5,2 Go) · mistral:7b (4,1 Go)
#   32 Go -> ce que tu veux
#
# Les modeles installes :  ollama list
#
# ── Le modele « nova » ────────────────────────────────────────────────────
#
# C'est un modele construit LOCALEMENT par Modelfile, base sur
# huihui_ai/qwen3.5-abliterated:4b — 3,3 Go. Il ne s'obtient pas par
# `ollama pull nova` : cette commande echouerait. Il faut le construire :
#
#     ollama create nova -f Modelfile
#     ollama list                        # doit montrer nova:latest
#
# C'est pour ca qu'il n'est PAS le defaut de `settings.py` : un defaut doit
# fonctionner sur une machine qui vient de cloner le depot, et celui-la
# rendrait une 404 dont le remede affiche (« ollama pull nova ») est faux.
# Le defaut reste rattrapable ; ici, dans .env, on nomme le vrai.
#
#     NOVA_CHAT_MODEL=nova
#
# ⚠️ Base Qwen 3.x = modele hybride : il peut monologuer avant de repondre.
# Nova injecte `/no_think` tant que NOVA_THINKING reste faux. Verifie apres
# le changement que le premier mot arrive vite ; sinon, mesure :
#
#     uv run python scripts/bench_models.py nova
NOVA_CHAT_MODEL=llama3.2:3b
NOVA_EMBEDDING_MODEL=bge-m3

# Reglages
NOVA_TEMPERATURE=0.4
NOVA_LOG_LEVEL=INFO

# ⚠️ A REMESURER A CHAQUE CHANGEMENT DE MODELE — SINON DEUX REGLAGES SE
# DECRIVENT MUTUELLEMENT DE TRAVERS.
#
# Vitesse d'ECRITURE en jetons/s, dont le routeur se sert pour ecarter un
# modele trop lent. Le defaut (28,8) a ete releve avec llama3.2:3b. Laisse tel
# quel apres etre passe a un modele plus gros, il fait croire au routeur qu'un
# modele de 3,3 Go ecrit a la vitesse d'un modele de 2,0 Go.
#
#     uv run python scripts/bench_models.py nova
#     NOVA_VITESSE_MESUREE=<le chiffre rendu>
# NOVA_VITESSE_MESUREE=28.8

# Raisonnement visible avant la reponse (Qwen 3.x). Faux = `/no_think` injecte
# sur TOUS les chemins, y compris le vocal. Vrai pour l'analyse lourde.
# NOVA_THINKING=false

# ── Voix de Nova ──────────────────────────────────────────────────────────
#
# La synthese est LOCALE depuis qu'ElevenLabs s'est tu en pleine conversation :
#
#     "This request exceeds your quota of 10000. You have 3 credits remaining"
#
# Dix mille credits par mois, une reponse ~150 caracteres : soixante reponses
# mensuelles. Un assistant dont la voix depend d'un quota n'est pas un
# assistant personnel, c'est un abonnement qui parle.
#
#     brew install espeak-ng          # indispensable au francais
#     uv pip install -e ".[speech]"
#
# `ff_siwis` a ete choisie A L'OREILLE parmi sept voix — c'est celle qui se
# rapprochait le plus de la voix d'origine. Pour comparer sur ta machine :
#
#     ./scripts/essayer-voix-locales.sh
#
# NOVA_VOIX_MODELE=ff_siwis
# NOVA_VOIX_LANGUE=f

# ── Le Model Router : quel cerveau pour quelle tache ──────────────────────
#
# ⚠️ RIEN A CONFIGURER. TOUT TOURNE EN LOCAL, ET RIEN NE SORT DE LA MACHINE.
#
# Le routeur choisit un modele par USAGE, jamais par nom. Nommer les usages
# plutot que les modeles est ce qui rend le systeme durable : « vocal » reste
# vrai en 2035, « llama3.2:3b » non.
#
#     vocal          le modele ne doit pas monologuer avant de repondre
#     conversation   le local d'abord ; un recours s'il tombe
#     raisonnement   le plus capable d'abord
#     extraction     deduire un chemin lit des noms de fichiers personnels
#     code           aucun modele local ne declare cette capacite aujourd'hui
#     long_contexte  aucun modele de 3 Go ne tient cent mille jetons
#
# Voir ce que le routeur ferait, sans rien appeler :  GET /v1/capacites
#
# Un fournisseur distant a existe ici et a ete RETIRE sur demande. Le jour ou
# tu voudras un second cerveau — un autre modele Ollama, un modele specialise,
# le tien — il s'ajoute dans `nova/modeles/` et nulle part ailleurs.
